# ========================================================
# EASD — ECOSISTEMA DIGITAL ECLESIAL 360° / OS ARQSD
# Production Environment Variables Blueprint (.env.example)
# ========================================================

# --- SERVER & NETWORKING ---
# Application runtime port (3000 in dev/container, or assigned by Hostinger/Cloud Run)
PORT=3000
NODE_ENV=production
# Authorized CORS origins (comma-separated list, NO wildcard in production)
ALLOWED_ORIGINS=https://arquidiocesisd.org,https://diariocatolico.org,https://televida.org.do,https://radiovidafm.org,https://radioabc.org,https://multimediosvida.org

# --- HOSTINGER NODE.JS WEB APP CONFIGURATION ---
HOSTINGER=false
HOSTINGER_PORT=3000

# --- GEMINI / GOOGLE AI STUDIO ---
# Server-side API key for Google Gemini AI (Fidelis Pastoral Assistant, Canonical Audit)
GEMINI_API_KEY=
# Public or internal app deployment URL
APP_URL=

# --- FIREBASE CLIENT CONFIGURATION ---
# Auto-provisioned in AI Studio or provided via Firebase Console
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

